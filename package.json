{
  "name": "cat-cafe-reservation-api",
  "version": "1.0.0",
  "description": "REST API for cat cafe reservations, cats, and visit assignments.",
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --env-file=.env --watch src/server.js",
    "start": "prisma db push --accept-data-loss && npm run seed && node src/server.js",
    "postinstall": "prisma generate",
    "seed": "node --env-file=.env prisma/seed.js",
    "lint": "eslint ."
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.3.0",
    "@prisma/client": "^7.3.0",
    "bcrypt": "^6.0.0",
    "express": "^5.1.0",
    "express-validator": "^7.2.1",
    "js-yaml": "^4.1.1",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.1",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "dotenv": "^17.2.3",
    "eslint": "^9.29.0",
    "eslint-config-prettier": "^10.1.5",
    "globals": "^16.2.0",
    "prettier": "^3.6.1",
    "prisma": "^7.3.0"
  }
}
